rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if signed-in user has is_admin == 1 in users/{uid}
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == 1;
    }

    // 1. Categories: Public read, auto-seed / admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Items (Product Catalog): Public read, Admin + Checkout/Cancel stock transaction write
    match /items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Users: Customers read/write their own profile; Admin portal reads customer profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 4. Carts & Cart Items: Authenticated user owns their cart
    match /carts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /cart_items/{cartItemId} {
      allow read, write: if isSignedIn();
    }

    // 5. Orders: Authenticated customers create & view/cancel their own orders; Admin manages all orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 6. Stock Transactions (Inventory Audit Trail)
    match /stock_transactions/{txId} {
      allow read, write: if true;
    }

    // 7. Contacts (Customer Inquiries): Public submission from Contact Us form; Admin management
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}

